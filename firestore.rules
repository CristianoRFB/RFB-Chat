rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function controlPath(uid) { return /databases/$(database)/documents/accountControls/$(uid); }
    function accountStatus(uid) {
      return exists(controlPath(uid)) ? get(controlPath(uid)).data.status : 'active';
    }
    function moderator() {
      return signedIn() && accountStatus(request.auth.uid) == 'active' && (admin()
        || (exists(controlPath(request.auth.uid))
          ? get(controlPath(request.auth.uid)).data.role == 'moderator'
          : request.auth.token.get('moderator', false) == true));
    }
    function activeAdmin() { return admin() && accountStatus(request.auth.uid) == 'active'; }
    function canReadChat() { return signedIn() && accountStatus(request.auth.uid) != 'banned'; }
    function canPost() { return signedIn() && accountStatus(request.auth.uid) == 'active'; }
    function validName(name) {
      return name is string && name.size() >= 2 && name.size() <= 40;
    }
    function isMember(conversationId) {
      return canReadChat()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
    }
    function blockedBetween(a, b) {
      return (exists(/databases/$(database)/documents/userPrivate/$(a))
          && b in get(/databases/$(database)/documents/userPrivate/$(a)).data.blockedUids)
        || (exists(/databases/$(database)/documents/userPrivate/$(b))
          && a in get(/databases/$(database)/documents/userPrivate/$(b)).data.blockedUids);
    }
    // Um bloqueio em DM interrompe novas interações entre as duas contas.
    // Grupos preservam suas próprias políticas de membership/moderação.
    function interactionAllowed(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data.kind == 'group'
        || !blockedBetween(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds[0],
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds[1]);
    }
    function validText(data) {
      return data.body is string
        && data.body.size() > 0
        && data.body.size() <= 2000
        && data.body.matches('(?s).*[^[:space:]].*');
    }
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if activeAdmin() && request.query.limit <= 50;
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'createdAt'])
        && request.resource.data.uid == uid
        && validName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time;
      allow update: if own(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && validName(request.resource.data.displayName);
      allow delete: if false;
    }
    match /userPrivate/{uid} {
      allow get: if own(uid);
      allow list: if false;
      allow create, update: if own(uid)
        && request.resource.data.keys().hasOnly(['blockedUids', 'notificationsEnabled', 'readReceiptsEnabled'])
        && request.resource.data.keys().hasAll(['blockedUids', 'notificationsEnabled', 'readReceiptsEnabled'])
        && request.resource.data.blockedUids is list
        && request.resource.data.blockedUids.size() <= 100
        && request.resource.data.notificationsEnabled is bool
        && request.resource.data.readReceiptsEnabled is bool;
      allow delete: if false;
    }
    // Admin bootstrap é claim confiável; papéis delegados e restrições têm efeito em Rules.
    match /accountControls/{uid} {
      function eventPath(eventId) { return /databases/$(database)/documents/accountControls/$(uid)/events/$(eventId); }
      function validControl() {
        let d = request.resource.data;
        return activeAdmin() && request.auth.uid != uid
          && exists(/databases/$(database)/documents/profiles/$(uid))
          && d.keys().hasOnly(['role','status','reason','actorId','updatedAt','eventId'])
          && d.keys().hasAll(['role','status','reason','actorId','updatedAt','eventId'])
          && d.role in ['member','moderator'] && d.status in ['active','suspended','banned']
          && d.reason is string && d.reason.size() >= 10 && d.reason.size() <= 300
          && d.actorId == request.auth.uid && d.updatedAt == request.time
          && d.eventId is string && d.eventId.size() > 0 && d.eventId.size() <= 100
          && !exists(eventPath(d.eventId))
          && getAfter(eventPath(d.eventId)).data == d;
      }
      allow get: if own(uid) || activeAdmin();
      allow list: if activeAdmin() && request.query.limit <= 50;
      allow create: if validControl();
      allow update: if validControl()
        && (request.resource.data.role != resource.data.role || request.resource.data.status != resource.data.status);
      allow delete: if false;
      match /events/{eventId} {
        allow get: if activeAdmin();
        allow list: if activeAdmin() && request.query.limit <= 50;
        allow create: if activeAdmin() && request.auth.uid != uid
          && request.resource.data.eventId == eventId
          && getAfter(controlPath(uid)).data == request.resource.data
          && getAfter(controlPath(uid)).data.updatedAt == request.time;
        allow update, delete: if false;
      }
    }
    function reportRatePath(uid) { return /databases/$(database)/documents/reportRate/$(uid); }
    match /reportRate/{uid} {
      allow get: if own(uid);
      allow list, delete: if false;
      allow create, update: if own(uid)
        && request.resource.data.keys().hasOnly(['reportId','createdAt'])
        && request.resource.data.keys().hasAll(['reportId','createdAt'])
        && request.resource.data.reportId is string && request.resource.data.createdAt == request.time
        && (!exists(reportRatePath(uid)) || request.time >= resource.data.createdAt + duration.value(30,'s'))
        && !exists(/databases/$(database)/documents/reports/$(request.resource.data.reportId))
        && getAfter(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.reporterId == uid
        && getAfter(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.createdAt == request.time;
    }
    match /reports/{reportId} {
      function eventPath(status) { return /databases/$(database)/documents/reports/$(reportId)/events/$(status); }
      allow create: if signedIn()
        && getAfter(reportRatePath(request.auth.uid)).data.reportId == reportId
        && getAfter(reportRatePath(request.auth.uid)).data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['reporterId','reportedUid','conversationId','reason','status','createdAt'])
        && request.resource.data.keys().hasAll(['reporterId','reportedUid','conversationId','reason','status','createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.conversationId is string
        && isMember(request.resource.data.conversationId)
        && request.resource.data.reportedUid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.memberIds
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow get: if signedIn() && (resource.data.reporterId == request.auth.uid
        || moderator());
      allow list: if moderator() || (signedIn() && resource.data.reporterId == request.auth.uid && request.query.limit <= 50);
      allow update: if moderator() && request.auth.uid != resource.data.reporterId && request.auth.uid != resource.data.reportedUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedAt','reviewedBy'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['status','resolvedAt'])
        && request.resource.data.reviewedBy == request.auth.uid
        && ((resource.data.status == 'open' && request.resource.data.status in ['reviewed', 'closed'])
          || (resource.data.status == 'reviewed' && request.resource.data.status == 'closed'))
        && request.resource.data.resolvedAt == request.time
        && !exists(eventPath(request.resource.data.status))
        && getAfter(eventPath(request.resource.data.status)).data == {
          'status': request.resource.data.status, 'actorId': request.auth.uid, 'createdAt': request.time
        };
      allow delete: if false;
      match /events/{status} {
        allow get, list: if moderator();
        allow create: if moderator()
          && status in ['reviewed','closed']
          && request.resource.data == {'status':status,'actorId':request.auth.uid,'createdAt':request.time}
          && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.status == status
          && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.reviewedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.resolvedAt == request.time;
        allow update, delete: if false;
      }
    }
    match /privacyRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerId','kind','status','createdAt','note'])
        && request.resource.data.keys().hasAll(['ownerId','kind','status','createdAt','note'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.kind in ['access','erasure','appeal']
        && requestId == request.auth.uid + '_' + request.resource.data.kind
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdAt == request.time
        && request.resource.data.note is string && request.resource.data.note.size() <= 500;
      allow get: if activeAdmin() || (signedIn() && requestId in [request.auth.uid+'_access',request.auth.uid+'_erasure',request.auth.uid+'_appeal']);
      allow list: if activeAdmin() && request.query.limit <= 50;
      allow update: if activeAdmin() && resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
        && request.resource.data.status == 'under_review' && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    match /conversations/{conversationId} {
      allow get, list: if canReadChat() && request.auth.uid in resource.data.memberIds;
      allow create: if canPost() && (signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'createdBy', 'memberIds', 'createdAt'])
        && request.resource.data.keys().hasAll(['kind', 'createdBy', 'memberIds', 'createdAt'])
        && request.resource.data.kind == 'dm'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds[0] is string
        && request.resource.data.memberIds[1] is string
        && request.resource.data.memberIds[0] < request.resource.data.memberIds[1]
        && request.auth.uid in request.resource.data.memberIds
        && conversationId == 'dm_' + request.resource.data.memberIds[0] + '_' + request.resource.data.memberIds[1]
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.memberIds[0]))
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.memberIds[1]))
        && !blockedBetween(request.resource.data.memberIds[0], request.resource.data.memberIds[1])
        && request.resource.data.createdAt == request.time
        || (signedIn()
          && request.resource.data.keys().hasOnly(['kind', 'title', 'createdBy', 'adminIds', 'memberIds', 'createdAt'])
          && request.resource.data.keys().hasAll(['kind', 'title', 'createdBy', 'adminIds', 'memberIds', 'createdAt'])
          && request.resource.data.kind == 'group'
          && conversationId.matches('^group_[a-zA-Z0-9_-]{12,}$')
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.memberIds == [request.auth.uid]
          && request.resource.data.adminIds == [request.auth.uid]
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 2
          && request.resource.data.title.size() <= 80
          && request.resource.data.createdAt == request.time));
      // Não permite que administradores acrescentem membros diretamente.
      // Só o próprio convidado aceito pode ampliar memberIds.
      allow update: if canPost() && ((isMember(conversationId)
          && resource.data.kind == 'group'
          && (
            (request.auth.uid in resource.data.adminIds
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
              && request.resource.data.title is string
              && request.resource.data.title.size() >= 2
              && request.resource.data.title.size() <= 80)
            || (resource.data.createdBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds'])
              && request.resource.data.adminIds is list
              && request.resource.data.adminIds.size() <= 20
              && request.resource.data.adminIds.hasAll([resource.data.createdBy])
              && resource.data.memberIds.hasAll(request.resource.data.adminIds))
          ))
          || (signedIn() && resource.data.kind == 'group'
            && !(request.auth.uid in resource.data.memberIds)
            && resource.data.memberIds.size() < 20
            && exists(/databases/$(database)/documents/conversations/$(conversationId)/invites/$(request.auth.uid))
            && get(/databases/$(database)/documents/conversations/$(conversationId)/invites/$(request.auth.uid)).data.status == 'accepted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds is list
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds));
      allow delete: if false;
      match /invites/{targetUid} {
        allow get: if canReadChat() && (request.auth.uid == targetUid || isMember(conversationId));
        allow list: if isMember(conversationId);
        allow create: if canPost() && isMember(conversationId)
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.kind == 'group'
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.adminIds
          && request.resource.data.keys().hasOnly(['targetUid', 'invitedBy', 'createdAt', 'status'])
          && request.resource.data.keys().hasAll(['targetUid', 'invitedBy', 'createdAt', 'status'])
          && request.resource.data.targetUid == targetUid
          && request.resource.data.invitedBy == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/profiles/$(targetUid))
          && !blockedBetween(targetUid, request.auth.uid)
          && !(targetUid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds);
        allow update: if canPost() && own(targetUid)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted', 'declined'];
        allow delete: if false;
      }
      match /presence/{uid} {
        allow get, list: if isMember(conversationId) && interactionAllowed(conversationId);
        allow create, update: if canPost() && own(uid) && isMember(conversationId) && interactionAllowed(conversationId)
          && request.resource.data.keys().hasOnly(['updatedAt','typing'])
          && request.resource.data.keys().hasAll(['updatedAt','typing'])
          && request.resource.data.updatedAt == request.time && request.resource.data.typing is bool;
        allow delete: if own(uid) && isMember(conversationId);
      }
      // Chamada de voz WebRTC local: somente sinalização, sem TURN/SFU externo.
      match /channels/{channelId} {
        allow get, list: if isMember(conversationId)
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.kind == 'group';
        allow create: if canPost() && isMember(conversationId)
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.kind == 'group'
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.adminIds
          && request.resource.data.keys().hasOnly(['name','description','createdBy','createdAt'])
          && request.resource.data.keys().hasAll(['name','description','createdBy','createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 40
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 300
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if canPost() && isMember(conversationId)
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.adminIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 40
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 300;
        allow delete: if false;
        match /messages/{messageId} {
          allow get, list: if isMember(conversationId);
          allow create: if canPost() && isMember(conversationId)
            && exists(/databases/$(database)/documents/conversations/$(conversationId)/channels/$(channelId))
            && request.resource.data.keys().hasOnly(['senderId','body','createdAt'])
            && request.resource.data.keys().hasAll(['senderId','body','createdAt'])
            && request.resource.data.senderId == request.auth.uid
            && validText(request.resource.data)
            && request.resource.data.createdAt == request.time;
          allow update: if canPost() && isMember(conversationId)
            && resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','editedAt'])
            && validText(request.resource.data)
            && request.resource.data.editedAt == request.time;
          allow delete: if false;
        }
      }
      match /calls/{callId} {
        allow get, list: if isMember(conversationId);
        allow create: if canPost() && isMember(conversationId) && interactionAllowed(conversationId)
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.kind == 'dm'
          && request.resource.data.keys().hasOnly(['initiatorId','calleeId','status','offer','createdAt'])
          && request.resource.data.keys().hasAll(['initiatorId','calleeId','status','offer','createdAt'])
          && request.resource.data.initiatorId == request.auth.uid
          && request.resource.data.calleeId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
          && request.resource.data.calleeId != request.auth.uid
          && request.resource.data.status == 'ringing'
          && request.resource.data.offer is string
          && request.resource.data.offer.size() > 0
          && request.resource.data.offer.size() <= 20000
          && request.resource.data.createdAt == request.time;
        allow update: if canPost() && isMember(conversationId)
          && (
            (request.auth.uid == resource.data.calleeId
              && interactionAllowed(conversationId)
              && resource.data.status == 'ringing'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','answer','answeredAt'])
              && request.resource.data.status == 'connected'
              && request.resource.data.answer is string
              && request.resource.data.answer.size() > 0
              && request.resource.data.answer.size() <= 20000
              && request.resource.data.answeredAt == request.time)
            || (resource.data.status in ['ringing','connected']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endedAt'])
              && request.resource.data.status == 'ended'
              && request.resource.data.endedAt == request.time)
          );
        allow delete: if false;
        match /ice/{candidateId} {
          allow get, list: if isMember(conversationId);
          allow create: if canPost() && isMember(conversationId)
            && interactionAllowed(conversationId)
            && exists(/databases/$(database)/documents/conversations/$(conversationId)/calls/$(callId))
            && get(/databases/$(database)/documents/conversations/$(conversationId)/calls/$(callId)).data.status in ['ringing','connected']
            && request.resource.data.keys().hasOnly(['senderId','candidate','createdAt'])
            && request.resource.data.keys().hasAll(['senderId','candidate','createdAt'])
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.candidate is string
            && request.resource.data.candidate.size() > 0
            && request.resource.data.candidate.size() <= 8000
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
      }
      match /attachments/{fileId} {
        allow get: if isMember(conversationId) && resource.data.expiresAt > request.time;
        allow list: if false;
        allow create: if canPost() && isMember(conversationId) && interactionAllowed(conversationId)
          && request.resource.data.keys().hasOnly(['ownerId','filename','mimeType','dataUrl','byteSize','createdAt','expiresAt'])
          && request.resource.data.keys().hasAll(['ownerId','filename','mimeType','dataUrl','byteSize','createdAt','expiresAt'])
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.filename is string
          && request.resource.data.filename.size() > 0
          && request.resource.data.filename.size() <= 120
          && request.resource.data.mimeType in ['image/png','image/jpeg','application/pdf','text/plain','video/webm','video/mp4']
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 410000
          && request.resource.data.dataUrl.matches('^data:' + request.resource.data.mimeType + ';base64,[A-Za-z0-9+/=]+$')
          && request.resource.data.byteSize is int
          && request.resource.data.byteSize > 0
          && request.resource.data.byteSize <= 300000
          && request.resource.data.dataUrl.size() <= request.resource.data.byteSize * 2 + 80
          && request.resource.data.dataUrl.size() >= request.resource.data.byteSize
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(24, 'h');
        allow update: if false;
        // O autor pode eliminar o conteúdo armazenado, inclusive após o link expirar.
        allow delete: if isMember(conversationId) && resource.data.ownerId == request.auth.uid
          && !existsAfter(/databases/$(database)/documents/conversations/$(conversationId)/mediaIndex/$(fileId));
      }
      match /mediaIndex/{fileId} {
        function attachment() { return getAfter(/databases/$(database)/documents/conversations/$(conversationId)/attachments/$(fileId)).data; }
        allow get: if isMember(conversationId);
        allow list: if isMember(conversationId) && request.query.limit <= 50;
        allow create: if canPost() && isMember(conversationId) && interactionAllowed(conversationId)
          && request.resource.data.keys().hasOnly(['ownerId','filename','mimeType','byteSize','createdAt','expiresAt'])
          && request.resource.data.keys().hasAll(['ownerId','filename','mimeType','byteSize','createdAt','expiresAt'])
          && request.resource.data.ownerId == request.auth.uid && attachment().ownerId == request.auth.uid
          && request.resource.data.filename == attachment().filename && request.resource.data.mimeType == attachment().mimeType
          && request.resource.data.byteSize == attachment().byteSize && request.resource.data.createdAt == attachment().createdAt
          && request.resource.data.expiresAt == attachment().expiresAt && request.resource.data.expiresAt > request.time;
        allow update: if false;
        allow delete: if isMember(conversationId)
          && get(/databases/$(database)/documents/conversations/$(conversationId)/attachments/$(fileId)).data.ownerId == request.auth.uid
          && !existsAfter(/databases/$(database)/documents/conversations/$(conversationId)/attachments/$(fileId));
      }
      match /messages/{messageId} {
        allow get, list: if isMember(conversationId);
        allow create: if canPost() && isMember(conversationId)
          && request.resource.data.keys().hasOnly(['senderId', 'body', 'createdAt', 'replyToId', 'kind', 'audioData', 'mimeType', 'durationMs', 'forwarded'])
          && request.resource.data.keys().hasAll(['senderId', 'body', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && interactionAllowed(conversationId)
          && validText(request.resource.data)
          && request.resource.data.createdAt == request.time
          && (
            (!('kind' in request.resource.data) && !('audioData' in request.resource.data)
              && !('mimeType' in request.resource.data) && !('durationMs' in request.resource.data))
            || (request.resource.data.kind == 'audio'
              && request.resource.data.body == 'Mensagem de voz'
              && request.resource.data.mimeType == 'audio/webm'
              && request.resource.data.audioData is string
              && request.resource.data.audioData.size() <= 275000
              && request.resource.data.audioData.matches('^data:audio/webm;base64,[A-Za-z0-9+/=]+$')
              && request.resource.data.durationMs is int
              && request.resource.data.durationMs > 0
              && request.resource.data.durationMs <= 60000)
          )
          && (!('forwarded' in request.resource.data) || (request.resource.data.forwarded == true && !('kind' in request.resource.data) && !('replyToId' in request.resource.data)))
          && (!('replyToId' in request.resource.data)
            || (request.resource.data.replyToId is string
              && request.resource.data.replyToId.size() > 0
              && request.resource.data.replyToId != messageId
              && exists(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.replyToId))
              && !('deletedAt' in get(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.replyToId)).data)));
        allow update: if canPost() && isMember(conversationId) && !('deletedAt' in resource.data) && (
          (resource.data.senderId == request.auth.uid && interactionAllowed(conversationId)
            && !('kind' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt'])
            && request.resource.data.diff(resource.data).affectedKeys().hasAll(['body', 'editedAt'])
            && validText(request.resource.data) && request.resource.data.editedAt == request.time)
          || (resource.data.senderId == request.auth.uid && !('kind' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','deletedAt','pinned'])
            && request.resource.data.body == 'Mensagem excluída'
            && request.resource.data.deletedAt == request.time && request.resource.data.pinned == false)
          || (interactionAllowed(conversationId)
            && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.kind == 'dm'
              || request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.adminIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
            && request.resource.data.pinned is bool)
        );
        allow delete: if false;
        match /reactions/{uid} {
          allow get, list: if isMember(conversationId);
          allow create: if canPost() && own(uid) && isMember(conversationId)
            && interactionAllowed(conversationId)
            && exists(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId))
            && !('deletedAt' in get(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId)).data)
            && request.resource.data.keys().hasOnly(['emoji', 'createdAt'])
            && request.resource.data.keys().hasAll(['emoji', 'createdAt'])
            && request.resource.data.emoji in ['👍', '❤️', '😂', '🎉', '😮']
            && request.resource.data.createdAt == request.time;
          allow update: if canPost() && own(uid) && isMember(conversationId)
            && interactionAllowed(conversationId)
            && !('deletedAt' in get(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId)).data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emoji'])
            && request.resource.data.emoji in ['👍', '❤️', '😂', '🎉', '😮'];
          allow delete: if own(uid) && isMember(conversationId);
        }
      }
      match /reads/{uid} {
        allow get, list: if isMember(conversationId);
        allow create: if own(uid) && isMember(conversationId)
          && request.resource.data.keys().hasOnly(['lastReadAt', 'lastDeliveredAt'])
          && request.resource.data.keys().hasAny(['lastReadAt', 'lastDeliveredAt'])
          && (!('lastReadAt' in request.resource.data) || request.resource.data.lastReadAt == request.time)
          && (!('lastDeliveredAt' in request.resource.data) || request.resource.data.lastDeliveredAt == request.time);
        allow update: if own(uid) && isMember(conversationId)
          && request.resource.data.keys().hasOnly(['lastReadAt', 'lastDeliveredAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt', 'lastDeliveredAt'])
          && (!('lastReadAt' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.lastReadAt == request.time)
          && (!('lastDeliveredAt' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.lastDeliveredAt == request.time);
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
