rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function validName(name) {
      return name is string && name.size() >= 2 && name.size() <= 40;
    }
    function isMember(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
    }
    function validText(data) {
      return data.body is string
        && data.body.size() > 0
        && data.body.size() <= 2000;
    }
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'createdAt'])
        && request.resource.data.uid == uid
        && validName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time;
      allow update: if own(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && validName(request.resource.data.displayName);
      allow delete: if false;
    }
    match /conversations/{conversationId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'createdBy', 'memberIds', 'createdAt'])
        && request.resource.data.keys().hasAll(['kind', 'createdBy', 'memberIds', 'createdAt'])
        && request.resource.data.kind == 'dm'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds[0] is string
        && request.resource.data.memberIds[1] is string
        && request.resource.data.memberIds[0] != request.resource.data.memberIds[1]
        && request.auth.uid in request.resource.data.memberIds
        && conversationId == 'dm_' + request.resource.data.memberIds[0] + '_' + request.resource.data.memberIds[1]
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.memberIds[0]))
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.memberIds[1]))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /messages/{messageId} {
        allow get, list: if isMember(conversationId);
        allow create: if isMember(conversationId)
          && request.resource.data.keys().hasOnly(['senderId', 'body', 'createdAt', 'replyToId'])
          && request.resource.data.keys().hasAll(['senderId', 'body', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && validText(request.resource.data)
          && request.resource.data.createdAt == request.time
          && (!('replyToId' in request.resource.data)
            || (request.resource.data.replyToId is string
              && request.resource.data.replyToId.size() > 0
              && request.resource.data.replyToId != messageId
              && exists(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.replyToId))));
        allow update: if isMember(conversationId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll(['body', 'editedAt'])
          && validText(request.resource.data)
          && request.resource.data.editedAt == request.time;
        allow delete: if false;
        match /reactions/{uid} {
          allow get, list: if isMember(conversationId);
          allow create: if own(uid) && isMember(conversationId)
            && exists(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(messageId))
            && request.resource.data.keys().hasOnly(['emoji', 'createdAt'])
            && request.resource.data.keys().hasAll(['emoji', 'createdAt'])
            && request.resource.data.emoji in ['👍', '❤️', '😂', '🎉', '😮']
            && request.resource.data.createdAt == request.time;
          allow update: if own(uid) && isMember(conversationId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emoji'])
            && request.resource.data.emoji in ['👍', '❤️', '😂', '🎉', '😮'];
          allow delete: if own(uid) && isMember(conversationId);
        }
      }
      match /reads/{uid} {
        allow get, list: if isMember(conversationId);
        allow create, update: if own(uid) && isMember(conversationId)
          && request.resource.data.keys().hasOnly(['lastReadAt'])
          && request.resource.data.keys().hasAll(['lastReadAt'])
          && request.resource.data.lastReadAt == request.time;
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
