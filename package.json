{
  "name": "01-rfbchat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/flow.test.ts tests/chat-model.test.ts tests/chat-extras.test.ts tests/attachments.test.ts",
    "test:rules": "firebase emulators:exec --project demo-rfb-chat --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "emulators": "firebase emulators:start --project demo-rfb-chat --only auth,firestore",
    "test:e2e": "playwright test",
    "media:purge:local": "node scripts/purge-expired-media.mjs",
    "admin:local": "node scripts/set-local-admin.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "15.37.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "5.1.2"
  },
  "overrides": {
    "tar": "^7.5.21",
    "@grpc/grpc-js": "^1.13.6"
  }
}
